# ---------------------------------------------------------------------------
# AI Legal Metrology Compliance Scanner - environment configuration
# Copy to `.env` and adjust. Never commit a filled-in `.env`.
# ---------------------------------------------------------------------------

# Database. Default is a local SQLite file; use PostgreSQL in production.
# DATABASE_URL=postgresql://user:password@localhost:5432/legal_metrology
DATABASE_URL=sqlite:///inspections.db

# --- Security (PRD 30) -----------------------------------------------------
# Authentication is OFF by default so the demo runs without setup. Turn it on
# for any deployment that is reachable by more than one person.
AUTH_ENABLED=false

# Signs bearer tokens. REQUIRED when AUTH_ENABLED=true - without it a random
# key is generated at start-up and every restart invalidates all sessions.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET_KEY=

# Session lifetime in seconds (default 8 hours).
AUTH_TOKEN_TTL_SECONDS=28800

# Creates the first admin account on start-up, only when no user exists yet.
# There is no default account: leave these unset and no account is created.
# AUTH_BOOTSTRAP_USER=admin
# AUTH_BOOTSTRAP_PASSWORD=

# Comma-separated allowed origins for the API. `*` is the dev default so the
# local Gradio frontend works; set real origins in production.
CORS_ORIGINS=*

# Largest accepted upload per package surface, in bytes (default 20 MB).
MAX_UPLOAD_BYTES=20971520

# --- OCR engine ------------------------------------------------------------
# Requires Python <= 3.12 (paddlepaddle ships no wheel for 3.13/3.14).

# paddlepaddle 3.3.x crashes in its oneDNN kernels on the PP-OCRv6 detector
# ("ConvertPirAttribute2RuntimeAttribute not support"). Disabled by default;
# set true to re-enable once that upstream bug is fixed.
OCR_ENABLE_MKLDNN=false

# accurate = PP-OCRv6_medium (~140 s/image, avg confidence 0.917) - default
# fast     = PP-OCRv5_mobile  (~62 s/image, avg confidence 0.864)
# Measured on one CPU core with a 1957x2648 label photo. Lower OCR confidence
# routes more packages to MANUAL_REVIEW, so speed is paid for in human review.
OCR_PROFILE=accurate

# Textline orientation classification costs ~8 s/image; only needed when label
# text is rotated relative to the capture.
OCR_TEXTLINE_ORIENTATION=true
